// Color Range mask (Phase 7 slice 5, second half) — per-pixel "how similar
// is this pixel to the picked color" weight, jointly matching hue +
// saturation + luminance. The second custom Core Image kernel in this
// codebase (after SelectiveColor.cikernel) — no built-in Core Image filter
// exposes per-pixel hue, and none can express a 3-axis joint color distance.
// See EditPipeline's colorRangeMaskImage/ColorRangeSelection.swift for the
// Swift-side wrapper and the Swift/GLSL twin conversion functions that MUST
// agree with the math below.
//
// target = (hueDegrees, saturation, linearLuminance, unused)
// window = (hueWindowDegrees, saturationWindow, lowerLuminanceSpan, upperLuminanceSpan)
// falloff = the falloff ramp's width, in NORMALIZED-DISTANCE units
//
// Unlike SelectiveColor's 8 fixed raised-cosine bands, this kernel
// synthesizes the RGB==alpha convention CIBlendWithMask needs DIRECTLY
// (returns vec4(w,w,w,w)) — no CIMaskToAlpha indirection needed, since a
// custom kernel can just emit a neutral premultiplied value itself.

vec3 rgb2hsl(vec3 c) {
    float M = max(c.r, max(c.g, c.b));
    float m = min(c.r, min(c.g, c.b));
    float C = M - m;
    float L = 0.5 * (M + m);
    float S = (C == 0.0) ? 0.0 : C / (1.0 - abs(2.0*L - 1.0));
    float H = 0.0;
    if (C > 0.0) {
        if (M == c.r)      H = mod((c.g - c.b)/C, 6.0);
        else if (M == c.g) H = (c.b - c.r)/C + 2.0;
        else               H = (c.r - c.g)/C + 4.0;
        H *= 60.0;
        if (H < 0.0) H += 360.0;
    }
    return vec3(H, S, L);
}

kernel vec4 colorRangeMask(__sample s, vec4 target, vec4 window, float falloff) {
    float a = s.a;
    vec3 rgb = (a > 0.0) ? s.rgb / a : s.rgb;
    // Clamp negative channels to 0 FIRST -- ColorRangeSelection.hueSaturation's
    // own doc comment: an improvement over SelectiveColor.cikernel, which
    // normalizes headroom but never clamps negatives (logged as a follow-up
    // on that older file, not touched here).
    vec3 clamped = max(rgb, vec3(0.0, 0.0, 0.0));

    // Rec.709 luma on the ORIGINAL (non-headroom-normalized) clamped
    // values -- luma is well-defined for headroom, unlike HSL's L.
    float luma = dot(clamped, vec3(0.2126, 0.7152, 0.0722));

    // Headroom-normalize (scale = max(maxChannel, 1.0)) before rgb2hsl --
    // the same fix SelectiveColor.cikernel already shipped for a real bug:
    // HSL's 1-|2L-1| saturation denominator goes negative for L>1.
    float M = max(clamped.r, max(clamped.g, clamped.b));
    float scale = max(M, 1.0);
    vec3 hsl = rgb2hsl(clamped / scale);

    // Hue axis: circular distance / window, ATTENUATED by the pixel's own
    // saturation combined with the target's -- a neutral pixel's hue is
    // arbitrary and shouldn't inflate distance (SelectiveColor.cikernel's
    // own band-weight-by-saturation precedent, same reason). The converse
    // (a neutral pixel matching a saturated target) is caught by the
    // independent saturation axis below.
    float hueDist = abs(hsl.x - target.x);
    hueDist = min(hueDist, 360.0 - hueDist);
    float saturationAttenuation = min(hsl.y, target.y);
    float dHue = (hueDist / window.x) * saturationAttenuation;

    // Saturation axis.
    float dSat = abs(hsl.y - target.y) / window.y;

    // Luminance axis: asymmetric spans below/above the target.
    float dLum;
    if (luma < target.z) {
        dLum = (target.z - luma) / window.z;
    } else {
        dLum = (luma - target.z) / window.w;
    }

    float d = sqrt(dHue*dHue + dSat*dSat + dLum*dLum);
    float w = clamp((1.0 - d) / falloff, 0.0, 1.0);
    return vec4(w, w, w, w);
}
