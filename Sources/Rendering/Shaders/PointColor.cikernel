// Point Color — Lightroom-style per-color eyedropper refinement. Targets
// ONE arbitrary picked color (not 8 fixed named bands like
// SelectiveColor.cikernel) with an independent Hue/Saturation/Luminance
// delta. This kernel is a generalization of SelectiveColor.cikernel's
// proven shape (raised-cosine hue falloff, headroom-normalize before HSL,
// unnormalized weighted delta) to one arbitrary center, plus a NEW
// saturation-distance axis so a picked pale pink and a picked saturated
// red are correctly treated as different targets, not just "same hue
// family." See EditPipeline.applyPointColors for the Swift-side wrapper
// and why this kernel runs inside the perceptual sandwich (matching
// Selective Color's own domain, NOT Mask.colorRange's scene-linear one).
//
// Deliberately NO luminance-distance SELECTION axis (v1 scope choice,
// not a domain impossibility — reviewer-corrected: `hslv.z` is already
// computed in this kernel's own working domain, directly comparable to
// a stored target with no round-trip needed). The real reason: headroom
// normalization (`rgb / max(M, 1)`) makes `L` RELATIVE — a 1.4-peak red
// and a 0.7-peak red can normalize to the same `L`, so a naive luminance
// axis would conflate genuinely different brightnesses on headroom
// content. Consequence, a real divergence from Lightroom's own Point
// Color: a bright highlight and a dark shadow of the same picked
// hue/saturation are inseparable by this kernel (logged in
// IMPROVEMENTS.md).
//
// target = (targetHueDegrees, targetSaturation, hueWindowDegrees, saturationWindow)
// hue/saturation/luminance: -1...1 adjustment amounts, 0 = identity.
//
// Reviewer-caught real bug, fixed here: `rgb2hsl` returns a FABRICATED
// hue of 0 for any achromatic pixel (`C == 0` branch). With no gate on
// the hue axis, a neutral/near-neutral pixel was scored against that
// fabricated 0 exactly like a real hue — a legitimately-picked
// desaturated target near hue 0 falsely selected EVERY neutral pixel in
// the frame (a visible global luminance artifact), while one further
// from hue 0 (e.g. a cool gray at hue 210) falsely selected NONE of the
// neutral content it was picked from. `hueWeight` below is a `mix`
// between "hue irrelevant" (1.0) and the real raised-cosine falloff,
// interpolated by the PIXEL's own saturation via `smoothstep` — at
// `hslv.y == 0` the fabricated hue never contributes at all; the
// saturation axis alone still correctly rejects a mismatched-saturation
// pixel regardless of hue.

vec3 rgb2hsl(vec3 c) {
    float M = max(c.r, max(c.g, c.b));
    float m = min(c.r, min(c.g, c.b));
    float C = M - m;
    float L = 0.5 * (M + m);
    float S = (C == 0.0) ? 0.0 : C / (1.0 - abs(2.0*L - 1.0));
    float H = 0.0;
    if (C > 0.0) {
        if (M == c.r)      H = mod((c.g - c.b)/C, 6.0);
        else if (M == c.g) H = (c.b - c.r)/C + 2.0;
        else               H = (c.r - c.g)/C + 4.0;
        H *= 60.0;
        if (H < 0.0) H += 360.0;
    }
    return vec3(H, S, L);
}

vec3 hsl2rgb(vec3 hslv) {
    float H = hslv.x;
    float S = hslv.y;
    float L = hslv.z;
    float C = (1.0 - abs(2.0*L - 1.0)) * S;
    float Hp = H / 60.0;
    float X = C * (1.0 - abs(mod(Hp, 2.0) - 1.0));
    float mm = L - 0.5*C;
    vec3 rgb;
    if (Hp < 1.0)      rgb = vec3(C, X, 0.0);
    else if (Hp < 2.0) rgb = vec3(X, C, 0.0);
    else if (Hp < 3.0) rgb = vec3(0.0, C, X);
    else if (Hp < 4.0) rgb = vec3(0.0, X, C);
    else if (Hp < 5.0) rgb = vec3(X, 0.0, C);
    else               rgb = vec3(C, 0.0, X);
    return rgb + vec3(mm, mm, mm);
}

// Raised-cosine falloff over a 1-D distance `d`, window `W`. 1.0 at d=0,
// smoothly 0.0 at d=W. Same shape as SelectiveColor.cikernel's
// bandWeights, generalized to a single scalar distance (not a vec4 of 4
// band distances at once).
float raisedCosine(float d, float W) {
    if (d >= W) { return 0.0; }
    return 0.5 * (1.0 + cos(3.14159265 * d / W));
}

kernel vec4 pointColor(__sample s, vec4 target, float hue, float saturation, float luminance) {
    float kHue = 30.0;
    float kLum = 0.25;

    float a = s.a;
    vec3 rgb = (a > 0.0) ? s.rgb / a : s.rgb;

    // Headroom-normalize before rgb2hsl — the same already-shipped fix
    // SelectiveColor.cikernel documents: HSL's 1-|2L-1| saturation
    // denominator goes negative for L>1, which would otherwise make this
    // kernel a silent no-op on bright saturated content (skies, boosted
    // highlights). Rescaled back by `scale` at the end, so headroom is
    // preserved, not destructively clamped.
    float M = max(rgb.r, max(rgb.g, rgb.b));
    float scale = max(M, 1.0);
    vec3 normalizedRGB = rgb / scale;
    vec3 hslv = rgb2hsl(normalizedRGB);

    // Hue axis: circular distance, raised-cosine falloff. Gated by the
    // pixel's own saturation (see this file's header comment) — below
    // `kHueMeaningfulSaturation` the pixel's hue is fabricated/
    // meaningless, so the hue axis contributes NOTHING (mixes to 1.0,
    // i.e. "no hue penalty") rather than scoring against that fabricated
    // value.
    float kHueMeaningfulSaturation = 0.1;
    float hueDist = abs(hslv.x - target.x);
    hueDist = min(hueDist, 360.0 - hueDist);
    float hueRaised = raisedCosine(hueDist, target.z);
    float hueWeight = mix(1.0, hueRaised, smoothstep(0.0, kHueMeaningfulSaturation, hslv.y));

    // Saturation axis: linear distance, raised-cosine falloff. NOT
    // weighted by the pixel's own raw saturation the way
    // SelectiveColor.cikernel's fixed bands are -- a Point Color instance
    // can legitimately target a desaturated/neutral picked color, where
    // that weighting would wrongly suppress the very pixels it should
    // select.
    float satDist = abs(hslv.y - target.y);
    float satWeight = raisedCosine(satDist, target.w);

    float weight = hueWeight * satWeight;
    if (weight < 0.0001) {
        // Untouched: exact passthrough, including headroom and
        // premultiplied alpha, unchanged -- matches
        // SelectiveColor.cikernel's own guard.
        return s;
    }

    // Unnormalized (not divided by weight): hue=saturation=luminance=0
    // collapses to an exact identity regardless of weight, matching
    // SelectiveColor.cikernel's own precedent.
    float hueDelta = weight * hue * kHue;
    float lumDelta = weight * luminance * kLum;
    float satMul = 1.0 + weight * saturation;

    float newH = mod(hslv.x + hueDelta, 360.0);
    if (newH < 0.0) { newH = newH + 360.0; }
    float newS = clamp(hslv.y * satMul, 0.0, 1.0);
    float newL = clamp(hslv.z + lumDelta, 0.0, 1.0);

    vec3 outRGB = hsl2rgb(vec3(newH, newS, newL)) * scale;
    return vec4(outRGB * a, a);
}
