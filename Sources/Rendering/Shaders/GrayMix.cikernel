// B&W Mix — per-colour darken/lighten of a black-and-white conversion (Lightroom's "B&W Mix", Photos has no equivalent).
//
// Two inputs of the SAME extent: `colour` = the image just BEFORE Black & White's forced desaturation, and `gray` = that
// image after it (CIColorControls saturation 0, so R=G=B). The kernel measures which of the 8 Selective Color hue bands the
// COLOUR pixel belongs to (same centres, same raised-cosine falloff, same default window width as SelectiveColor.cikernel,
// range 0.5 -> W = 50 degrees, weights scaled by the pixel's own HSL saturation so neutrals get none) and scales the EXISTING
// grey by 2^(kStops * sum(weight * mix)) — a multiplier on the PERCEPTUAL (sRGB-encoded) grey, since this runs inside the
// perceptual block, so it is not a linear-light stop count. Alpha is carried through untouched (the grey is premultiplied,
// so scaling its rgb by a scalar is correct while alpha stays). Scaling the existing grey rather than re-deriving luma means all-zero mix is
// exactly the unmodified B&W render, and the output stays R=G=B with no clamp (headroom above 1.0 survives).
//
// Overlapping bands ADD, deliberately like SelectiveColor.cikernel's unnormalised sum: with W = 50 degrees and centres 30
// degrees apart, a pure orange gets Orange 1.0 + Red ~0.35 + Yellow ~0.35, so 'all sliders -1' is not an even darkening.
//
// Mix argument layout: mixA = (Red, Orange, Yellow, Green), mixB = (Aqua, Blue, Purple, Magenta), each -1...1.
// Headroom: the colour pixel is normalised by max(M, 1) before HSL, the same fix SelectiveColor.cikernel documents (a
// coloured pixel brighter than 1.0 otherwise drives the HSL saturation denominator negative).

vec3 rgb2hsl(vec3 c) {
    float M = max(c.r, max(c.g, c.b));
    float m = min(c.r, min(c.g, c.b));
    float C = M - m;
    float L = 0.5 * (M + m);
    float S = (C == 0.0) ? 0.0 : C / (1.0 - abs(2.0*L - 1.0));
    float H = 0.0;
    if (C > 0.0) {
        if (M == c.r)      H = mod((c.g - c.b)/C, 6.0);
        else if (M == c.g) H = (c.b - c.r)/C + 2.0;
        else               H = (c.r - c.g)/C + 4.0;
        H *= 60.0;
        if (H < 0.0) H += 360.0;
    }
    return vec3(H, S, L);
}

vec4 bandWeights(float H, vec4 centers, float W) {
    vec4 d = abs(vec4(H,H,H,H) - centers);
    vec4 dc = min(d, vec4(360.0,360.0,360.0,360.0) - d);
    vec4 within = step(dc, vec4(W,W,W,W));
    vec4 raised = 0.5 * (vec4(1.0,1.0,1.0,1.0) + cos(3.14159265 * dc / W));
    return within * raised;
}

kernel vec4 grayMix(__sample colour, __sample gray, vec4 mixA, vec4 mixB, float stops) {
    vec4 centersA = vec4(0.0, 30.0, 60.0, 120.0);
    vec4 centersB = vec4(180.0, 240.0, 280.0, 320.0);
    float W = 50.0;

    float a = colour.a;
    vec3 rgb = (a > 0.0) ? colour.rgb / a : colour.rgb;
    float scale = max(max(rgb.r, max(rgb.g, rgb.b)), 1.0);
    vec3 hslv = rgb2hsl(rgb / scale);

    // Clamped: the working space is EXTENDED sRGB, so a wide-gamut (P3) shadow can carry negative channels, which drives the
    // HSL saturation formula far outside 0...1 (and diverges as M+m -> 0). Unclamped, exp2() below turned that into
    // multipliers up to ~1e26 or a flipped slider direction. SelectiveColor clamps its own output, which hides the same thing.
    float sat = clamp(hslv.y, 0.0, 1.0);
    vec4 wA = bandWeights(hslv.x, centersA, W) * sat;
    vec4 wB = bandWeights(hslv.x, centersB, W) * sat;
    float total = dot(wA, mixA) + dot(wB, mixB);
    return vec4(gray.rgb * exp2(stops * total), gray.a);
}
